    {
      "id": "eWll7fKGVkaKo5GR__TPh",
      "type": "text",
      "x": -4021.740234375019,
      "y": -48213.15840657513,
      "width": 1278.0371093749998,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b8t",
      "roundness": null,
      "seed": 1212037333,
      "version": 919,
      "versionNonce": 1568702357,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779131241408,
      "link": null,
      "locked": false,
      "text": "A lightweight, Java 17–compatible connector certified for Mule 4,\ndesigned to reduce complexity and runtime footprint.\n\nLow-code / no-code experience inside Anypoint Studio™\n\nEncapsulates authentication, error handling, and session management\n\nSupports BSFN, UBE, web services, token operations, and event polling\n\nIdeal for API-led connectivity and enterprise integration patterns",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A lightweight, Java 17–compatible connector certified for Mule 4, designed to reduce complexity and runtime footprint.\n\nLow-code / no-code experience inside Anypoint Studio™\n\nEncapsulates authentication, error handling, and session management\n\nSupports BSFN, UBE, web services, token operations, and event polling\n\nIdeal for API-led connectivity and enterprise integration patterns",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "pHkoZ1CNAkydLIw6-Zq8J",
      "type": "text",
      "x": -4021.691406250019,
      "y": -47636.01912434857,
      "width": 1877.7050781250002,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b8u",
      "roundness": null,
      "seed": 481342805,
      "version": 643,
      "versionNonce": 1289078005,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779131241408,
      "link": null,
      "locked": false,
      "text": "The Atina JDE MCP Server turns your JD Edwards EnterpriseOne™ into a backend for AI.\n\nExposes curated JDE operations (e.g., list, review, and approve purchase orders) through Model Context\nProtocol (MCP)\n\nAllows AI agents (Claude, ChatGPT, etc.) to call JDE safely via your Atina microservice\n\nIdeal for scenarios such as:\n\nConversational approval of purchase orders\n\nNatural-language queries on JDE master data\n\n​Assisted with data entry and validation",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Atina JDE MCP Server turns your JD Edwards EnterpriseOne™ into a backend for AI.\n\nExposes curated JDE operations (e.g., list, review, and approve purchase orders) through Model Context Protocol (MCP)\n\nAllows AI agents (Claude, ChatGPT, etc.) to call JDE safely via your Atina microservice\n\nIdeal for scenarios such as:\n\nConversational approval of purchase orders\n\nNatural-language queries on JDE master data\n\n​Assisted with data entry and validation",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "n7pofJGLWojAhZkDV6AK1",
      "type": "text",
      "x": -4021.193359375019,
      "y": -48630.28517659466,
      "width": 1309.453125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
