    {
      "id": "Vpm9IcWA3bxUEYZHuvdsD",
      "type": "text",
      "x": -4044.4022115071757,
      "y": -51092.27888997356,
      "width": 782.6514282226562,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b8C",
      "roundness": null,
      "seed": 1144341941,
      "version": 825,
      "versionNonce": 2027565307,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "MgcKdi1z71IUZeuOSwA9m",
          "type": "arrow"
        }
      ],
      "updated": 1779131235467,
      "link": null,
      "locked": false,
      "text": "Simplifies the generation of the .ini files\nrequired for the integration. Atina allows\nthe same microservice to be used across\nmultiple JDE environments, such as JDV920,\nJPS920, JPD920, and others.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Simplifies the generation of the .ini files required for the integration. Atina allows the same microservice to be used across multiple JDE environments, such as JDV920, JPS920, JPD920, and others.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "iulBQCJlcbzc3T11qQu11",
      "type": "text",
      "x": -4124.926890055353,
      "y": -50163.55167643189,
      "width": 915.6962280273435,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b8D",
      "roundness": null,
      "seed": 1128352757,
      "version": 1143,
      "versionNonce": 1778407835,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "0KYSjgOcBSuuIh4lM9V9R",
          "type": "arrow"
        }
      ],
      "updated": 1779131235467,
      "link": null,
      "locked": false,
      "text": "Packages all required Oracle JD Edwards libraries\ninto a single deployment bundle.\nWhen migrating to a new Tools Release, only this\nbundle needs to be rebuilt, with no changes required\nin the integration layer.\nThe JARs Generation Tool also supports embedding\nAtina with custom-developed web services.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Packages all required Oracle JD Edwards libraries into a single deployment bundle.\nWhen migrating to a new Tools Release, only this bundle needs to be rebuilt, with no changes required in the integration layer.\nThe JARs Generation Tool also supports embedding Atina with custom-developed web services.",
      "autoResize": false,
      "lineHeight": 1.25
    },
