      "isDeleted": false,
      "boundElements": null,
      "updated": 1779131218896,
      "link": null,
      "locked": false,
      "text": "The connector encapsulates the complexity of JD\nEdwards integration. Instead of rebuilding JDE\nconnectivity for every integration project, Atina\ncentralizes.",
      "fontSize": 48.54427083333328,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The connector encapsulates the complexity of JD Edwards integration. Instead of rebuilding JDE connectivity for every integration project, Atina centralizes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
