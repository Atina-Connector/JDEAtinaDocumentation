      "locked": false,
      "text": "Atina JDE Integration Platform",
      "fontSize": 45.93749999999986,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atina JDE Integration Platform",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "9BGhIiVnwWlIa39Iby7Hn",
      "type": "text",
      "x": -3251.6067708333453,
      "y": -57569.35510253864,
      "width": 1161.9670764310713,
      "height": 510.6901041666624,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b5o",
      "roundness": null,
      "seed": 1861375989,
      "version": 590,
      "versionNonce": 470457493,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779125792206,
      "link": null,
      "locked": false,
      "text": "Atina Connection is a JDE-focused\nintegration platform built around a\ndedicated microservice that speaks JD\nEdwards EnterpriseOne™ natively and\nexposes that power through multiple\nproducts: Connectors, AI MCP Server,\nRest API and future integrations.",
      "fontSize": 58.364583333332845,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Atina Connection is a JDE-focused integration platform built around a dedicated microservice that speaks JD Edwards EnterpriseOne™ natively and exposes that power through multiple products: Connectors, AI MCP Server, Rest API and future integrations.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "sTwgzIvoWRmZmIUCn5icQ",
      "type": "text",
      "x": -4397.127604166679,
      "y": -56870.09769693968,
      "width": 2032.2138400607648,
      "height": 351.71875000000017,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b5p",
      "roundness": null,
      "seed": 176169755,
      "version": 268,
      "versionNonce": 476651515,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779124470090,
      "link": null,
      "locked": false,
      "text": "The Atina JDE Connector is based on a dedicated microservice that\ncommunicates directly with JDE. Communication between the MuleSoft\nconnector and the microservice is via gRPC (based on HTTP/2), which\nhelps mitigate latency issues in WAN environments and robustly improves\nDNS resolution.",
      "fontSize": 56.275000000000006,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Atina JDE Connector is based on a dedicated microservice that communicates directly with JDE. Communication between the MuleSoft connector and the microservice is via gRPC (based on HTTP/2), which helps mitigate latency issues in WAN environments and robustly improves DNS resolution.",
      "autoResize": false,
      "lineHeight": 1.25
    },
